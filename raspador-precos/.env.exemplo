# Copie este arquivo para ".env" e preencha só o canal que for usar.
# O arquivo .env está no .gitignore: suas senhas nunca vão para o GitHub.

# ---------- E-mail ----------
# No Gmail, use uma "senha de app" (Conta Google > Segurança > Senhas de app),
# não a senha normal da conta.
EMAIL_REMETENTE=seu.email@gmail.com
EMAIL_SENHA=abcd efgh ijkl mnop
EMAIL_DESTINO=seu.email@gmail.com
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PORTA=587

# ---------- Telegram ----------
# 1. Fale com o @BotFather, crie um bot e copie o token.
# 2. Mande uma mensagem para o seu bot e abra
#    https://api.telegram.org/bot<TOKEN>/getUpdates para ver o seu chat id.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
